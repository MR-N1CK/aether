#!/bin/sh
set -e

case "$1" in
    purge)
        # On purge, remove configuration directory if empty or specified
        rm -rf /etc/aether
        # STRICT PRESERVATION: Do NOT delete /var/log/aether/ or user scan reports (FR-017 / Principle I)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
    ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
    ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
